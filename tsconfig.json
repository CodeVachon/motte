{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["vitest/globals", "bun", "node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "paths": {
      "@motte/core": ["./packages/core/src/index.ts"],
      "@motte/core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["packages/*/src", "scripts"],
  "exclude": ["node_modules", "**/dist", "apps/web", "apps/site"]
}
